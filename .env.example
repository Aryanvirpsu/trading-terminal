# =============================================================
# tradingview-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is in .gitignore — it will NEVER be committed to git
# =============================================================

# ── Proxy (Optional — Webshare Rotating Residential) ──────────
# Get credentials from: https://proxy.webshare.io/proxy/list
# Enables access to Yahoo Finance, Xueqiu, and reduces Reddit rate-limits.
# Leave blank to run WITHOUT proxy (Reddit & RSS will still work).

PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME_PREFIX=your_username_prefix   # e.g. hvfvdamo
PROXY_PASSWORD=your_password_here
PROXY_SESSION_MIN=1
PROXY_SESSION_MAX=250

# Set to false to disable proxy entirely
PROXY_ENABLED=true

# ── Broker (Optional — real order execution) ──────────────────────
# UNCONFIGURED BY DEFAULT (BROKER_PROVIDER=none) — every live-mode call
# routes through NotConfiguredBroker, which reports "not configured" instead
# of doing anything. Until you set this up, use the paper-trading tools
# (paper_trade / paper_portfolio / paper_trade_history) — same interface,
# simulated fills, zero real-money risk.
#
# BROKER_PROVIDER=none | axisdirect | robinhood | zerodha | upstox | angelone
BROKER_PROVIDER=none

# ── Robinhood — IMPLEMENTED, but read this before using ────────────────────
# Wraps the community `robin_stocks` SDK — NOT an official Robinhood library.
# Robinhood has never published a public trading API; this replays their
# private mobile-app API, which is against their Terms of Service and has
# led to account restrictions for other users. There is ALSO NO PAPER MODE
# on Robinhood at all — every mode="live" order here is REAL MONEY,
# immediately, with no way to simulate first. UNTESTED against Robinhood's
# live API (no real credentials were available while building this).
#
# Setup, only if you've accepted the above:
#   1. pip install robin_stocks   (or: pip install -e ".[robinhood]")
#   2. Set BROKER_PROVIDER=robinhood and the two credentials below
#      (there's no API-key/OAuth flow — this needs your real account login)
#   3. Call the robinhood_login tool (pass mfa_code if you use an
#      authenticator app; SMS/email code prompts and app push-approval
#      aren't supported — see core/broker/robinhood.py for why)
#   4. place_order(mode="live", ...) and broker_status() now use Robinhood
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# ── Robinhood OFFICIAL MCP (READ-ONLY account view) ────────────────────────
# This is the official Robinhood MCP server (agent.robinhood.com/mcp/trading) —
# NOT robin_stocks and NOT SnapTrade. It authenticates with OAuth 2.0 + PKCE
# (you log in to Robinhood in your own browser; this app NEVER sees your password
# and only stores the resulting OAuth TOKEN). Phase 4A is READ-ONLY: it displays
# your Cash and Agentic accounts separately and never places orders.
#
# Nothing to paste here to START — run the guided auth flow in ROBINHOOD_MANUAL_TEST.md
# (python lab/robinhood_mcp.py register / authurl / exchange). These are optional
# overrides:
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TIMEOUT=20
ROBINHOOD_MCP_REDIRECT_URI=http://localhost:8765/callback
#
# HARD SAFETY SWITCH — must stay false in the read-only phase. While false, the
# MCP client REFUSES to call any write/order/money-moving tool, so no order can be
# placed even if one is discovered. Do NOT set this true in phase 4A.
ROBINHOOD_TRADING_ENABLED=false

# ── Axis Direct (Axis Securities) — IMPLEMENTED, swap-in takes ~5 minutes ──
# Wraps the community `rapidapi-axisdirect` SDK (NOT official Axis Direct
# library) — see core/broker/axisdirect.py. UNTESTED against Axis's live
# API (built by introspecting the SDK; no real credentials were available
# while building this) — verify carefully with a small order first.
#
# Setup once you have real credentials from Axis Direct's RAPID API portal:
#   1. pip install rapidapi-axisdirect   (or: pip install -e ".[axisdirect]")
#   2. Set BROKER_PROVIDER=axisdirect and the two keys below
#   3. Call the axisdirect_login_start tool, open the returned URL, log in
#   4. Copy the `ssoId` from the redirect URL, call axisdirect_login_complete
#      (session + refresh token are cached to
#      ~/.tradingview_mcp_data/axisdirect_session.json and auto-refreshed)
#   5. place_order(mode="live", ...) and broker_status() now use Axis Direct
AXISDIRECT_CLIENT_ID=
AXISDIRECT_AUTHORIZATION_KEY=

# Zerodha Kite Connect (paid API subscription, daily login token refresh) — NOT YET IMPLEMENTED
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_ACCESS_TOKEN=

# Upstox API (free tier for account holders, OAuth login token) — NOT YET IMPLEMENTED
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_ACCESS_TOKEN=

# Angel One SmartAPI (free for account holders, TOTP-based login) — NOT YET IMPLEMENTED
# ANGELONE_API_KEY=
# ANGELONE_CLIENT_ID=
# ANGELONE_PASSWORD=
# ANGELONE_TOTP_SECRET=

# =============================================================
# RESEARCH TERMINAL — data providers, model registry, search
# (all optional & free-tier; the terminal degrades gracefully
#  to a clearly-labelled state when a key is absent)
# =============================================================

# ── Free-tier market data keys (lab decision engine + research terminal) ──────
# Finnhub (free 60 req/min): quotes, company profile, fundamentals, analyst
#   recommendations, company news, earnings calendar — AND the US symbol universe
#   used to build the local security master (dashboard/security_master.py).
#   Get one free at https://finnhub.io/register
FINNHUB_API_KEY=
# FRED (free): macro series for the macro-sensitivity signal. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Alpha Vantage (free 25 req/day): optional supplementary fundamentals. https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Yahoo Finance, TradingView screener, StockTwits, Google News, SEC EDGAR:
#   no key required — used automatically as primary/fallback providers.

# ── SnapTrade (Optional — read-only brokerage link, e.g. Robinhood) ───────────
# Enables the read-only "Cash" account panel. Never trades. Leave blank to show
# a "not connected" state instead of any real-money data.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ── Model registry / FinBERT sentiment (lab/finbert_service.py) ───────────────
# The terminal's sentiment layer defaults to a fast, dependency-free LEXICAL
# scorer. ProsusAI/finbert is benchmarked in FINBERT_BENCHMARK.md: it clearly
# improves classification (macro F1 0.73 -> 0.78, hybrid 0.80; calibration halved;
# fixes regulatory + negative-recall blind spots) BUT costs ~712 MB RAM + a ~15 s
# CPU load. It is therefore shipped DISABLED by default — enable it only on a box
# with RAM headroom or a CUDA GPU. When on, the terminal uses the FinBERT+lexical
# HYBRID and falls back to lexical on any failure (a model outage never blanks UI).
#   Enable:  pip install "transformers>=4.41" torch   (GPU: install a CUDA torch)
#            then set SENTIMENT_MODEL_ENABLED=true
SENTIMENT_MODEL_ENABLED=false
SENTIMENT_MODEL=ProsusAI/finbert
FINBERT_TIMEOUT=8                 # per-batch inference timeout (s) before lexical fallback
# Declared for the RAG / forecasting slots (not required; see MODEL_EVALUATION.md).
# Enabling these has no effect until the corresponding deps are installed.
EMBEDDINGS_MODEL_ENABLED=false
EMBEDDINGS_MODEL=FinLang/finance-embeddings-investopedia
FORECAST_MODEL_ENABLED=false
FORECAST_MODEL=ibm-granite/granite-timeseries-ttm-r3

# ── Optional LLM (narrative analysis; not required for any core feature) ──────
# GEMINI_API_KEY=

# ── Multi-provider data engine (lab/providers.py) ─────────────────────────────
# TradingView is NOT a primary data source. It is an OPTIONAL technical-signal
# confirmation: the decision engine leads with Yahoo/yfinance and only consults
# TradingView if Yahoo is down AND this flag is on. The whole terminal (stock pages,
# scans, sector map) is fully functional with this set to false — see
# DATA_PROVIDER_MATRIX.md and DATA_QUALITY_AFTER.md.
TRADINGVIEW_ENABLED=true

# Allow data whose SOURCE timestamp is past its category freshness limit to drive a
# NEW trade decision. Off by default: stale data may RENDER the page (display-only)
# but must not create an actionable call. See lab/cache_policy.py.
DECISION_ALLOW_STALE=false

# Minimum weighted CATEGORY COVERAGE (0-1) for the data_quality gate, and the quality
# score needed for the conviction gate. Coverage is strategy-aware (momentum /
# analysis / options profiles in lab/data_quality.py) — a momentum scan does not need
# an option chain, an options trade does.
DECISION_MIN_DATA_QUALITY=0.55
DECISION_CONVICTION_MIN=60

# Explicit overrides for the two SOFT decision gates (both off by default). These are
# the ONLY way degraded data can reach TRADEABLE.
DECISION_ALLOW_FALLBACK_TRADEABLE=false
DECISION_ALLOW_HIGH_DISAGREEMENT=false

# ── PAPER TRADING — simulates a REAL $500 Robinhood cash account ──────────────
# The balance is part of the experiment, not a display setting: a strategy tested at
# $10,000 and scaled down afterwards is not the strategy this account can actually
# run. Every limit below is an ABSOLUTE DOLLAR amount checked against real buying
# power. See PAPER_TRADING_PLAN.md.
PAPER_LEDGER=robinhood_500_baseline
PAPER_INITIAL_CASH=500
PAPER_INITIAL_EQUITY=500
PAPER_BUYING_POWER=500
PAPER_MARGIN_ENABLED=false          # cash account: no margin, no leverage, no borrowing
PAPER_ALLOW_SHORTING=false
PAPER_ALLOW_NAKED_OPTIONS=false
PAPER_FRACTIONAL_SHARES=true        # Robinhood supports fractional shares

# Risk limits (absolute dollars)
PAPER_MAX_LOSS_PER_TRADE=5          # max planned loss per trade
PAPER_MAX_POSITION_NOTIONAL=125     # max capital in one stock position
PAPER_MIN_CASH_RESERVE_USD=100      # never spendable; buying power = cash - reserve
PAPER_MAX_DAILY_LOSS_USD=10
PAPER_MAX_DRAWDOWN_USD=50
PAPER_MAX_ENTRIES_PER_DAY=2
PAPER_MAX_OPEN=3
PAPER_MAX_PER_SECTOR=1
PAPER_MAX_CORRELATED=2
PAPER_COOLDOWN_LOSSES=3             # consecutive losses that trigger a cooldown
PAPER_COOLDOWN_DAYS=1

# Options — SHADOW MODE ONLY until PAPER_GRADUATION_CHECKLIST.md §A passes.
# Long single-leg only; no spreads, shorts, naked or multi-leg on a cash account.
PAPER_MAX_OPTION_PREMIUM=75         # max total premium (incl. spread) per trade
PAPER_OPTIONS_SHADOW_ONLY=true
PAPER_ALLOW_SPREADS=false
PAPER_ALLOW_MULTI_LEG=false

# Execution realism (never midpoint fills)
PAPER_SLIPPAGE_BPS=5
PAPER_GAP_SLIPPAGE_BPS=25
PAPER_FEE_PER_SHARE=0               # Robinhood is commission-free
# PAPER_DATA_DIR=~/.tradingview_mcp_data/paper   # ledger lives OUTSIDE the repo

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Port for the research terminal web app (dashboard/app.py). Default 5057.
DASHBOARD_PORT=5057

# ── NSE India options data (no key needed) ─────────────────────────
# nse_option_chain / nse_options_unusual_activity call NSE India's own public
# website API directly — no credentials to set here. Reliability depends on
# your network: NSE's Akamai bot-protection is far more permissive from
# residential/office IPs in India than from cloud/datacenter IPs. If these
# tools consistently return NSE_BLOCKED_OR_UNAVAILABLE, that's the network,
# not a missing setting — a broker API above is the reliable alternative.

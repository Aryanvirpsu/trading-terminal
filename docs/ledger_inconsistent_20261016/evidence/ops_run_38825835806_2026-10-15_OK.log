^[[36;1massert any(not n.startswith("shadow__") for n in names), "ledger missing from backup"^[[0m
^[[36;1mfor n, meta in m["files"].items():^[[0m
^[[36;1m    p = os.path.join(d, n)^[[0m
^[[36;1m    assert hashlib.sha256(open(p, "rb").read()).hexdigest() == meta["sha256"], f"sha mismatch {n}"^[[0m
^[[36;1m    assert sqlite3.connect(p).execute("PRAGMA integrity_check").fetchone()[0] == "ok", f"integrity {n}"^[[0m
^[[36;1m    print("verified", n, os.path.getsize(p), "bytes")^[[0m
^[[36;1mprint("backup", os.path.basename(d), "verified off-host")^[[0m
^[[36;1mPY^[[0m

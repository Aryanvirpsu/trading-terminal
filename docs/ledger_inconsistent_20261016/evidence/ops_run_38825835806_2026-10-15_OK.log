^[[36;1mimport hashlib, json, os, sqlite3, sys^[[0m
^[[36;1md = sys.argv[1]^[[0m
^[[36;1mm = json.load(open(os.path.join(d, "MANIFEST.json")))^[[0m
^[[36;1massert m["ok"], "host-side manifest not ok"^[[0m
^[[36;1mnames = sorted(m["files"])^[[0m

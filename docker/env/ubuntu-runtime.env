# AVDI Ubuntu paper runtime - operating settings (NOT Champion gates; no strategy knob lives here).
# Layered on top of env/case1.env (profile, TZ=UTC, PAPER_DATA_DIR=/data/case1/paper).
# Paper execution only: the runtime refuses to start if either of these is changed.
ROBINHOOD_TRADING_ENABLED=false
BROKER_PROVIDER=none
# Discovery cadence and entry window (defaults shown; entries stop 60 min before the close).
AVDI_DISCOVERY_INTERVAL_MIN=15
AVDI_ENTRY_CUTOFF_MIN_BEFORE_CLOSE=60
AVDI_TRACKER_FAST_S=60
AVDI_TRACKER_FULL_S=300
